# GitHub OAuth App credentials (required)
# Create one at: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL (optional, defaults to https://repolens.io)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub proxy URL for unauthenticated API requests (optional)
# NEXT_PUBLIC_GITHUB_PROXY_URL=

# Shared secret for server-side calls to the GitHub proxy (server-only — never
# NEXT_PUBLIC). Must match the worker's SERVER_SHARED_SECRET. Sent as the
# X-RepoLens-Server header from API routes / OG image generation.
# GITHUB_PROXY_SECRET=
